# DEXTube — ISOLATED TEST ENVIRONMENT (template)
#
# Copy to `.env.isolated-test` (which is git-ignored) or let
# `npm run isolated:setup` generate it for you. Everything here is disposable:
# its own database, its own media directory and its own build output, so it can
# never disturb the development or production instance.
#
#   DEXTUBE_ENV=isolated-test is what unlocks the destructive helpers
#   (`npm run isolated:reset`) and the one-time administrator bootstrap.
#   It is deliberately separate from NODE_ENV.
#
# Run it with:  npm run isolated:setup && npm run isolated:seed && npm run isolated:dev

NODE_ENV=development
DEXTUBE_ENV=isolated-test
APP_URL=http://localhost:3001
BIND_HOST=127.0.0.1
PORT=3001

# Separate database, same PostgreSQL server. `isolated:setup` creates it and
# refuses to continue if this name matches the development database name.
DATABASE_URL=postgresql://dextube:CHANGE_ME@localhost:5433/dextube_isolated_test
POSTGRES_USER=dextube
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dextube_isolated_test

# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=auto

# Separate media tree. `isolated:reset` verifies this path before deleting.
STORAGE_DRIVER=local
MEDIA_ROOT=./storage/isolated-test/media
MEDIA_PUBLIC_BASE=/media
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=7200
PROCESSING_CONCURRENCY=1
TRANSCODE_LADDER=480,360
ENABLE_HLS=false

# Named expectations the reset command checks itself against.
ISOLATED_DATABASE_NAME=dextube_isolated_test
ISOLATED_MEDIA_ROOT=./storage/isolated-test/media
# Authorized creator exports are read from here; nothing outside it is ever read.
CREATOR_EXPORT_ROOT=./storage/isolated-test/creator-exports

# Separate build output so running the test instance cannot clobber the `.next`
# a production service is serving from.
NEXT_DIST_DIR=.next-isolated

# One-time administrator bootstrap. Permitted only because DEXTUBE_ENV is
# isolated-test; refused outright in production. The account is created with
# mustChangePassword set, and is never overwritten on restart.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@admin.com
ADMIN_BOOTSTRAP_PASSWORD=admin

# Optional: enables the official YouTube Data API v3 for metadata (>15 entries).
# YOUTUBE_API_KEY=

YOUTUBE_API_KEY=
IMPORT_MAX_ITEMS=500
IMPORT_MAX_CONCURRENCY=4

RATE_LIMIT_DISABLED=false
JOB_RUNNER=inline
WORKER_POLL_MS=2000
