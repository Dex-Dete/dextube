# DEXTube environment configuration (placeholders only — never commit real secrets)
#
# Copy to `.env` and fill in real values for your machine.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the running app.
APP_URL=http://localhost:3000
# Bind address. 127.0.0.1 = localhost only (default, safe).
# Use 0.0.0.0 ONLY for deliberate LAN testing (see README "Local network (LAN) access").
BIND_HOST=127.0.0.1
PORT=3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Native Fedora PostgreSQL example:
#   postgresql://dextube:CHANGE_ME@localhost:5432/dextube
# Docker Compose example (see docker-compose.yml, host port 5433):
#   postgresql://dextube:CHANGE_ME@localhost:5433/dextube
DATABASE_URL=postgresql://dextube:CHANGE_ME@localhost:5433/dextube
POSTGRES_USER=dextube
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dextube

# ---------------------------------------------------------------------------
# Sessions / secrets
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_48
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Secure cookie + __Host- prefix policy.
#   auto  (default) = Secure only when APP_URL is https:// (required for LAN HTTP)
#   true            = always Secure (needs HTTPS, e.g. behind a TLS proxy)
#   false           = never Secure (plain-HTTP LAN only)
SESSION_COOKIE_SECURE=auto

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# local | s3   (s3 adapter is documented but requires configuration)
STORAGE_DRIVER=local
MEDIA_ROOT=./storage/media
# Public path media is served from (must be served by DEXTube itself or a proxy).
MEDIA_PUBLIC_BASE=/media
# Per-file upload limits.
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=7200
# Bounded FFmpeg concurrency — keep low on laptops (1-2).
PROCESSING_CONCURRENCY=1
# Transcode ladder: "off" (remux/original only) or "720,480,360"
TRANSCODE_LADDER=480,360
# HLS packaging (requires the ladder); enable only if your box can handle it.
ENABLE_HLS=false

# ---------------------------------------------------------------------------
# S3-compatible storage (only used when STORAGE_DRIVER=s3)
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Email (verification / password reset)
# When SMTP is not configured, DEXTube writes the message to
# storage/mail-outbox/*.eml and prints the verification/reset link to the
# server console in development. This is the documented local-dev flow.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DEXTube <no-reply@example.invalid>
SMTP_SECURE=false

# ---------------------------------------------------------------------------
# Rate limiting / abuse protection
# ---------------------------------------------------------------------------
RATE_LIMIT_DISABLED=false
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
VIEW_DEDUPE_SECONDS=1800

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
# "inline" runs jobs inside the web process (simple, dev default).
# "external" expects `npm run worker` to be running (production recommendation).
JOB_RUNNER=inline
WORKER_POLL_MS=2000
JOB_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Deployment identity and the one-time administrator
# ---------------------------------------------------------------------------
# "development" | "isolated-test" | "production".
#
# Kept separate from NODE_ENV on purpose: `next start` forces NODE_ENV=production
# even for a throwaway instance, so the destructive helpers and the administrator
# bootstrap key off this value instead. Only "isolated-test" unlocks them.
DEXTUBE_ENV=development

# One-time initial administrator. Refused outright when DEXTUBE_ENV=production.
# The database switch (`system_settings.admin_bootstrap_enabled`) must also be
# on, and the account is created with must-change-password set. See
# docs/deployment.md §13.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@admin.com
# Required whenever ADMIN_BOOTSTRAP_ENABLED=true and DEXTUBE_ENV is not
# isolated-test. Never logged, never returned by an API.
ADMIN_BOOTSTRAP_PASSWORD=

# What the isolated environment expects to be pointed at; the reset command
# refuses to delete anything until the live values match. See
# docs/deployment.md §12.
ISOLATED_DATABASE_NAME=dextube_isolated_test
ISOLATED_MEDIA_ROOT=./storage/isolated-test/media

# ---------------------------------------------------------------------------
# Authorized channel / playlist migration
# ---------------------------------------------------------------------------
# Optional. With a key, metadata comes from the official YouTube Data API v3
# (paginated, durations, more than 15 entries). Without one, DEXTube reads
# YouTube's official public channel/playlist feed, which only exposes the
# latest 15 entries. Original media is NEVER downloaded from YouTube: bytes can
# only arrive through an authorized creator export with a recorded basis.
YOUTUBE_API_KEY=
# Manifest root for authorized creator exports. Nothing outside this directory
# is ever read; path traversal and symlink escapes are refused.
CREATOR_EXPORT_ROOT=./storage/creator-exports
IMPORT_MAX_ITEMS=500
IMPORT_MAX_CONCURRENCY=4
IMPORT_HTTP_TIMEOUT_MS=15000
IMPORT_MAX_RESPONSE_BYTES=4194304
# Coarse per-instance ceiling on imported media.
STORAGE_QUOTA_BYTES=53687091200
